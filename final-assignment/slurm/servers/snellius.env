# Snellius (SURF): the cluster settings and shared paths for this course.
# You normally don't need to change anything here. To use another cluster, copy this file
# to servers/<name>.env, adapt it, and run the scripts with SERVER=<name>.

# --- cluster ------------------------------------------------------------------
PARTITION=gpu_a100             # A100 GPUs; see the SURF wiki for what each partition costs
ACCOUNT=                       # sbatch --account; empty = your default account
GPUS=1                         # GPUs per job
CPUS_PER_GPU=18                # CPU cores per GPU, used for data loading (--num-workers)

# --- containers ---------------------------------------------------------------
# The base images the challenge server runs submissions in. Jobs use the first one unless you pass
# --image to slurm/submit.sh. Each is the container file <dir>/nncv-<image>.sif.
IMAGES="pytorch transformers generative"
IMAGE_PREFIX=docker://ghcr.io/tue-aria/nncv-   # + <image>:<tag>, for `apptainer pull`
IMAGE_TAG=2027
CONTAINER_DIR=containers                       # your containers, relative to `final-assignment`

# --- data ---------------------------------------------------------------------
SHARED_DIR=/projects/0/TODO_5lsm0   # TODO(staff): shared course folder with the data
SHARED_CONTAINERS="$SHARED_DIR/containers"   # the same .sif files, pulled once by the staff
BIND_PATHS="$SHARED_DIR"            # host folders the container must see, besides your home folder

# --- logs ---------------------------------------------------------------------
LOG_DIR=slurm/logs             # slurm-<job>-<id>.out files, relative to `final-assignment`
