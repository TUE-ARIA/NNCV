# Environment variables for your jobs on Snellius, passed into the container.
# slurm/setup.sh copies this file to .env; fill in your key there. .env is never committed.

# Weights & Biases: your API key is at https://wandb.ai/authorize
WANDB_API_KEY=

# W&B files go to the wandb/ folder in `final-assignment` (not committed)
WANDB_DIR=wandb
WANDB_CONFIG_DIR=wandb/config
WANDB_CACHE_DIR=wandb/cache
WANDB_START_METHOD=thread
